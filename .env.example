COOKIE_SECURE=false
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_AUTH=true, MAIL_TLS=true,
# MAIL_USERNAME va MAIL_FROM la dia chi Gmail, MAIL_PASSWORD la App Password 16 ky tu.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false
MAIL_FROM=no-reply@techshop.example
# true: profile dev ghi email ra data/dev-mail. false: gui SMTP that.
MAIL_DEV=true
# Dang nhap Google: dat client id/secret qua bien moi truong
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID / ..._CLIENT_SECRET,
# hoac tao data/oauth-local.properties. Redirect URI: <CLIENT_URL>/login/oauth2/code/google
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
